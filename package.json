{
  "name": "corsair",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @corsair/web dev",
    "build": "vite build apps/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "probe:battle": "cd packages/minigame-sea-battle/probe && vitest run --config vitest.config.ts",
    "probe:career": "cd packages/systems-traffic/probe && vitest run --config vitest.config.ts",
    "verify": "tsc --noEmit -p tsconfig.json && vitest run && vite build apps/web && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "fast-png": "^8.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.0.3"
  }
}
